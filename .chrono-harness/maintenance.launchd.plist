<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.chrono-harness.example-maintenance</string>
	<key>ProgramArguments</key>
	<array>
		<string>/REPOSITORY/.chrono-harness/bin/chrono-worktree</string>
		<string>maintenance-service</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/REPOSITORY</string>
	<key>Sockets</key>
	<dict>
		<key>Maintenance</key>
		<dict>
			<key>SockType</key>
			<string>dgram</string>
			<key>SockPathName</key>
			<string>/REPOSITORY/.chrono-harness/state/maintenance.sock</string>
			<key>SockPathMode</key>
			<integer>384</integer>
		</dict>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/REPOSITORY/.chrono-harness/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
