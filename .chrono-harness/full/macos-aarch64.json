      },
      {
        "id": "judge-registration-ci-preparation-policy",
        "consumer": "judge:registration",
        "kind": "ci-preparation-policy",
        "inputs": [
          "input:ci-units-policy"
        ]
      }
    ],
    "coverage": {
      "schema": "chrono-input-coverage/v1",
      "required": [
        {
          "consumer": "judge:registration",
          "domains": [
            "git-facts",
            "local-check-inputs",
            "ci-check-inputs",
            "executable",
            "local-preparation-policy",
            "ci-preparation-policy"
          ]
        },
        {
          "consumer": "judge:workflow",
          "domains": [
            "branch-facts"
          ]
        },
        {
          "consumer": "script:message",
          "domains": [
            "python-execution"
          ]
        },
        {
          "consumer": "test:example",
          "domains": [
            "python-execution"
          ]
        },
        {
          "consumer": "script:installer",
          "domains": [
            "shell-execution"
          ]
        },
        {
          "consumer": "test:harness",
          "domains": [
            "installation-check"
          ]
        },
        {
          "consumer": "judge:projects",
          "domains": [
