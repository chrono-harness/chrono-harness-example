{
  "schema_version": 4,
  "status": "active",
  "enforcement": "enabled",
  "runner": {
    "path": ".chrono-harness/bin/chrono-harness",
    "version": "0.1.1",
    "sha256": "5071603912e59333e2399515ee9623a09793ccfcb3aa9ab4a9faa7ffcedb8f20"
  },
  "registries": {
    "judges": ".chrono-harness/full/judges-macos-aarch64.json",
    "projects": ".chrono-harness/projects.json",
    "filemap": ".chrono-harness/FILEMAP.json",
    "workflow": ".chrono-harness/workflow.json"
  },
  "canonical_check": {
    "operation": "validate.delta",
    "argv": [
      ".chrono-harness/bin/chrono-harness",
      "check"
    ],
    "profile": ".chrono-harness/config.json",
    "inputs": {
      "local": {
        "operation": "prepare.check.local",
        "tool": "chrono-worktree",
        "argv": [
          "check-inputs",
          "--config",
          ".chrono-harness/worktree.json"
        ]
      },
      "ci": {
        "operation": "prepare.check.ci",
        "tool": "chrono-ci",
        "argv": [
          "check-inputs",
          "--config",
          ".chrono-harness/ci/full.json",
          "--event-env",
          "GITHUB_EVENT_NAME",
          "--payload-env",
          "GITHUB_EVENT_PATH",
          "--revision-env",
          "CHRONO_WORKFLOW_REVISION",
          "--repository-env",
          "GITHUB_REPOSITORY"
        ]
      },
      "inherit_environment": [
        "GITHUB_EVENT_NAME",
        "GITHUB_EVENT_PATH",
        "CHRONO_WORKFLOW_REVISION",
        "GITHUB_REPOSITORY",
        "CHRONO_CI_DETECTION",
        "CHRONO_CI_NEEDS",
        "GITHUB_RUN_ID",
        "GITHUB_RUN_ATTEMPT",
        "GITHUB_JOB",
        "CHRONO_CHECK_SOURCE",
        "SSH_AUTH_SOCK"
      ]
    }
  },
  "protocol": {
    "id": "chrono-judge/v1",
    "timeout_seconds": 2400,
    "stdout_limit_bytes": 67108864,
    "encoding": "UTF-8"
  },
  "environment": {
    "credential_environment": [
      "GH_TOKEN"
    ],
    "inherit": [
      "PATH",
      "HOME",
      "TMPDIR",
      "GH_TOKEN"
    ],
    "values": {},
    "inputs": [
      {
        "id": "worktree-policy",
        "presence": "present",
        "location": ".chrono-harness/worktree.json",
        "sha256": "1799414fa31f37888416d54b797b901dac921ac4b6005adec0020c80935d2770"
      },
      {
        "id": "ci-units-policy",
        "presence": "present",
        "location": ".chrono-harness/ci/units.json",
        "sha256": "c7aab3005478972becbc2cc9ea387c4adf115e3f2648c0746e5fb92ae59c2e3e"
      },
      {
        "id": "python-executable",
        "presence": "present",
        "location": ".chrono-harness/bin/python3",
        "sha256": "68b74da398dbf5ed1ea1a00f425a8559e25f2b07f455ba264270614e5fff51ca"
      },
      {
        "id": "ci-executable",
        "presence": "present",
        "location": ".chrono-harness/bin/chrono-ci",
        "sha256": "4c28c97205a71b515227a4c5ab02b2034673c8c1bac742297490072b1e343ba9"
      }
    ]
  },
  "facts_git": {
    "tool": "git"
  },
  "input_closure": {
    "status": "declared-complete",
    "unresolved": [],
    "bindings": [
      {
        "id": "judge-registration-git-facts",
        "consumer": "judge:registration",
        "kind": "git-facts",
        "inputs": [
          "tool:git",
          "environment:PATH",
          "environment:HOME"
        ]
      },
      {
        "id": "judge-workflow-branch-facts",
        "consumer": "judge:workflow",
        "kind": "branch-facts",
        "inputs": [
          "tool:git"
        ]
      },
      {
        "id": "judge-registration-local-check-inputs",
        "consumer": "judge:registration",
        "kind": "local-check-inputs",
        "inputs": [
          "tool:chrono-worktree"
        ]
      },
      {
        "id": "judge-registration-ci-check-inputs",
        "consumer": "judge:registration",
        "kind": "ci-check-inputs",
        "inputs": [
          "tool:chrono-ci",
          "environment:GH_TOKEN",
          "input:ci-executable"
        ]
      },
      {
        "id": "script-message-python-execution",
        "consumer": "script:message",
        "kind": "python-execution",
        "inputs": [
          "tool:python3",
          "input:python-executable"
        ]
      },
      {
        "id": "test-example-python-execution",
        "consumer": "test:example",
        "kind": "python-execution",
        "inputs": [
          "tool:python3",
          "input:python-executable"
        ]
      },
      {
        "id": "script-installer-shell-execution",
        "consumer": "script:installer",
        "kind": "shell-execution",
        "inputs": [
          "tool:bash",
          "tool:python3",
          "environment:HOME",
          "environment:PATH",
          "input:python-executable"
        ]
      },
      {
        "id": "test-harness-installation-check",
        "consumer": "test:harness",
        "kind": "installation-check",
        "inputs": [
          "tool:python3",
          "tool:chrono-ci",
          "environment:TMPDIR",
          "environment:PATH",
          "input:python-executable",
          "input:ci-executable"
        ]
      },
      {
        "id": "judge-projects-executable",
        "consumer": "judge:projects",
        "kind": "executable",
        "inputs": [
          "tool:chrono-judge-projects"
        ]
      },
      {
        "id": "judge-registration-executable",
        "consumer": "judge:registration",
        "kind": "executable",
        "inputs": [
          "tool:chrono-judge-registration"
        ]
      },
      {
        "id": "judge-filemap-executable",
        "consumer": "judge:filemap",
        "kind": "executable",
        "inputs": [
          "tool:chrono-judge-filemap"
        ]
      },
      {
        "id": "judge-routes-executable",
        "consumer": "judge:routes",
        "kind": "executable",
        "inputs": [
          "tool:chrono-judge-routes"
        ]
      },
      {
        "id": "judge-registration-local-preparation-policy",
        "consumer": "judge:registration",
        "kind": "local-preparation-policy",
        "inputs": [
          "input:worktree-policy"
