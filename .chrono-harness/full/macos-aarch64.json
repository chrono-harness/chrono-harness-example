          ]
        },
        {
          "consumer": "judge:filemap",
          "domains": [
            "executable"
          ]
        },
        {
          "consumer": "judge:routes",
          "domains": [
            "executable"
          ]
        }
      ],
      "rows": [
        {
          "consumer": "judge:registration",
          "domain": "git-facts",
          "state": "bound",
          "bindings": [
            "judge-registration-git-facts"
          ],
          "reason": "The registration judge queries fixed Git objects and checks the bound Git facts producer."
        },
        {
          "consumer": "judge:workflow",
          "domain": "branch-facts",
          "state": "bound",
          "bindings": [
            "judge-workflow-branch-facts"
          ],
          "reason": "The workflow judge reads the candidate, fork and dev tip to check the registered branch."
        },
        {
          "consumer": "judge:registration",
          "domain": "local-check-inputs",
          "state": "bound",
          "bindings": [
            "judge-registration-local-check-inputs"
          ],
          "reason": "The registered local preparation runs worktree check-inputs. SSH_AUTH_SOCK is available only for an authenticated origin when present."
        },
        {
          "consumer": "judge:registration",
          "domain": "ci-check-inputs",
          "state": "bound",
          "bindings": [
            "judge-registration-ci-check-inputs"
          ],
          "reason": "The registered CI preparation binds event coordinates and the checked workflow. GH_TOKEN is an acquisition credential, represented by its presence only."
        },
        {
          "consumer": "script:message",
          "domain": "python-execution",
          "state": "bound",
          "bindings": [
            "script-message-python-execution"
          ],
          "reason": "Python runs message.py and reads the versioned message.txt."
        },
        {
          "consumer": "test:example",
          "domain": "python-execution",
          "state": "bound",
          "bindings": [
            "test-example-python-execution"
          ],
          "reason": "The registered test uses the bound interpreter with -B to read the versioned check, module and data."
        },
        {
          "consumer": "script:installer",
          "domain": "shell-execution",
          "state": "bound",
          "bindings": [
            "script-installer-shell-execution"
          ],
          "reason": "The installer resolves its installation root and starts Python to validate its location."
        },
        {
          "consumer": "test:harness",
          "domain": "installation-check",
          "state": "bound",
          "bindings": [
            "test-harness-installation-check"
          ],
          "reason": "The Python test creates a temporary directory and runs the installer with a stub. The separately registered ci.verify operation checks the generated workflow."
        },
        {
          "consumer": "judge:projects",
          "domain": "executable",
          "state": "bound",
          "bindings": [
            "judge-projects-executable"
          ],
          "reason": "The full check launches the pinned projects judge."
        },
        {
          "consumer": "judge:registration",
          "domain": "executable",
          "state": "bound",
          "bindings": [
            "judge-registration-executable"
          ],
          "reason": "The full check launches the pinned registration judge."
        },
        {
          "consumer": "judge:filemap",
          "domain": "executable",
          "state": "bound",
          "bindings": [
            "judge-filemap-executable"
          ],
          "reason": "The full check launches the pinned filemap judge."
        },
        {
          "consumer": "judge:routes",
          "domain": "executable",
          "state": "bound",
          "bindings": [
            "judge-routes-executable"
          ],
          "reason": "The full check launches the pinned routes judge."
        },
        {
          "consumer": "judge:registration",
          "domain": "local-preparation-policy",
          "state": "bound",
          "bindings": [
            "judge-registration-local-preparation-policy"
          ],
          "reason": "The local input producer reads this worktree policy."
        },
        {
          "consumer": "judge:registration",
          "domain": "ci-preparation-policy",
          "state": "bound",
          "bindings": [
            "judge-registration-ci-preparation-policy"
          ],
          "reason": "The CI input producer reads this collection policy."
        }
      ]
    }
