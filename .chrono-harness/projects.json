{
  "schema_version": 2,
  "status": "proposed",
  "owners": [
    "host",
    "message",
    "example",
    "installer",
    "harness"
  ],
  "projects": [],
  "scripts": [
    {
      "id": "message",
      "path": "message.py",
      "test_script": "example",
      "actions": {
        "execute": {
          "operation": "example.program",
          "tool": "python3",
          "argv": [
            "-B",
            "message.py"
          ]
        }
      },
      "language": "python"
    },
    {
      "id": "example",
      "path": "check.py",
      "tests_for": "message",
      "actions": {
        "execute": {
          "operation": "example.check",
          "tool": "python3",
          "argv": [
            "-B",
            "check.py"
          ]
        }
      },
      "language": "python"
    },
    {
      "id": "installer",
      "path": ".chrono-harness/ci/install.sh",
      "test_script": "harness",
      "actions": {
        "execute": {
          "operation": "tools.install",
          "tool": "bash",
          "argv": [
            ".chrono-harness/ci/install.sh"
          ]
        }
      },
      "language": "shell"
    },
    {
      "id": "harness",
      "path": ".chrono-harness/ci/check-install-location.py",
      "tests_for": "installer",
      "actions": {
        "execute": {
          "operation": "installer.check-location",
          "tool": "python3",
          "argv": [
            "-B",
            ".chrono-harness/ci/check-install-location.py"
          ]
        },
        "verify-workflow": {
          "operation": "ci.verify",
          "tool": "chrono-ci",
          "argv": [
            "verify",
            "--host-root",
            ".",
            "--config",
            ".chrono-harness/ci/units.json"
          ]
        },
        "verify-storage": {
          "operation": "verify.installer-storage",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link={operation_state}/verify.installer-storage.rlib,dep-info={operation_state}/verify.installer-storage.rlib.d",
            ".chrono-harness/ci/installer_storage.rs",
            "-o",
            "{operation_state}/verify.installer-storage.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        }
      },
      "language": "python"
    }
  ]
}
