{
  "schema": "chrono-worktree-automatic-cleanup/v2",
  "coordinator_root": "git-main-worktree",
  "state_directory": ".chrono-harness/state/automatic-cleanup-v2/",
  "retained_ref": "refs/heads/dev",
  "retention": "ancestor",
  "remove_branch": false,
  "allow_evidence_disposal": true,
  "age_policy": {
    "reuse_after_seconds": 82800,
    "delete_after_seconds": 86400,
    "preserved_branch_prefix": "retained/"
  },
  "artifacts": [
    {
      "path": ".chrono-harness/state/",
      "disposition": "finish-dispose"
    },
    {
      "path": "__pycache__/",
      "disposition": "finish-dispose"
    },
    {
      "path": ".chrono-harness/bin/",
      "disposition": "finish-dispose"
    }
  ],
  "terminal_history": {
    "keep_seconds": 86400,
    "max_entries": 32,
    "max_bytes": 4194304
  },
  "cache_history": {
    "keep_seconds": 86400,
    "max_entries": 32,
    "max_bytes": 4194304
  },
  "operation_scopes": {
    "example.program": {
      "reads": [
        "path:message.py",
        "path:message.txt",
        "path:.chrono-harness/ci/host_decisions.py",
        "path:.chrono-harness/ci/installer_storage.rs"
      ],
      "writes": []
    },
    "example.check": {
      "reads": [
        "path:check.py",
        "path:message.py",
        "path:message.txt",
        "path:.chrono-harness/ci/host_decisions.py",
        "path:.chrono-harness/ci/installer_storage.rs"
      ],
      "writes": []
    }
  }
}
