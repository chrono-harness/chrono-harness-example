diff --git a/.chrono-harness/ci/capture-launcher.sh b/.chrono-harness/ci/capture-launcher.sh
new file mode 100644
index 0000000..814cc22
--- /dev/null
+++ b/.chrono-harness/ci/capture-launcher.sh
@@ -0,0 +1,11 @@
+set -eu
+nested=$(mktemp -d "$TMPDIR/chrono-native-publication-failure-XXXXXXXX")
+registered=.chrono-harness/state/release-test-failures
+mkdir -p "$registered"
+code=0
+/bin/bash .chrono-harness/ci/bootstrap-native-tests.sh > "$nested/stdout" 2> "$nested/stderr" || code=$?
+cat "$nested/stderr" >&2
+printf '{"exit_code":%s}\n' "$code" > "$nested/process.json"
+cp "$nested/stderr" "$registered/launcher.stderr"
+printf 'original native publication process evidence: %s\n' "$nested" >&2
+exit "$code"
